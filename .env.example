# Wird von `docker compose` automatisch aus dem Repo-Root geladen. Fuer den
# Standardfall (alles auf demselben Rechner testen) NICHT noetig -- die
# Defaults unten sind bereits in docker-compose.yml hinterlegt.
#
# Nur anlegen (`cp .env.example .env`), wenn Frontend/Backend von einem
# ANDEREN Geraet erreichbar sein sollen, z.B. Testen vom Handy im lokalen
# Netz. Dann beide Werte auf die LAN-IP des Host-Rechners setzen
# (nicht localhost / 127.0.0.1), z.B. http://192.168.1.42:PORT.
#
# VITE_API_BASE   wird beim Frontend-Build ins Bundle eingebacken; der
#                 Browser (auch der auf dem Handy) spricht dieses Backend an.
#                 Aenderung erfordert `docker compose up --build frontend`.
# FRONTEND_ORIGIN muss exakt der URL entsprechen, unter der das Frontend im
#                 Browser laeuft -- sonst blockt die CORS-Middleware die
#                 API-Calls (backend/app/main.py).

VITE_API_BASE=http://localhost:8000
FRONTEND_ORIGIN=http://localhost:5173
